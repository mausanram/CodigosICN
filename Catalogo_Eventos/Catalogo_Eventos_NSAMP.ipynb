    "from functions_py import *\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib as mpl\n",
    "from mpl_toolkits.axes_grid1 import make_axes_locatable\n",
    "import numpy.ma as ma\n",
    "import pandas as pd \n",
    "import skimage as sk\n",
    "import scipy.ndimage as nd\n",
    "from array import array\n",
    "from functions_MuonsNSAMP1 import *\n",
    "\n",
    "from ROOT import TProfile, TGraphErrors, TH2F, TLegend\n",
    "import ROOT\n",
    "\n",
    "def gaussian(x, a, mean, sigma):\n",
    "    return a * np.exp(-((x - mean)**2 / (2 * sigma**2)))\n",
    "\n",
    "# def Gaussian2(x,m1,s1,g1,a1, m2, s2, g2, a2): #data, mean, sigma, gain, height1, heigth2\n",
    "#     return a1*np.exp(-1/2*((x-m1-g1)/s1)**2) + a2*np.exp(-1/2*((x-m2-g2)/s2)**2)\n",
    "\n",
    "def Gaussian2(x,m,s,g,a1,a2): #data, mean, sigma, gain, height1, heigth2\n",
    "    return a1*np.exp(-1/2*((x-m)/s)**2)+a2*np.exp(-1/2*((x-m-g)/s)**2)\n",
    "\n",
    "\n",
    "def EnergySpectrum(x, N):\n",
    "    return N * np.sin(x)*np.cos(x)**3\n",
    "\n",
    "def diffusion(x, alpha, beta):\n",
    "    return np.sqrt(alpha * np.log(1 - beta*x))/15\n",
    "\n",
    "maxdiff_ICN = np.around(diffusion(725, -281.8, 0.00098), 3)\n",
    "maxdiff_ICN_T = np.around(diffusion(725, -153.9, 0.00116), 3)\n",
    "porError_ICN = np.around(np.abs((maxdiff_ICN - maxdiff_ICN_T)/maxdiff_ICN_T) * 100, 3)\n",
    "\n",
    "maxdiff_CONN = np.around(diffusion(675, -211.9, 0.00102), 3)\n",
    "maxdiff_CONN_T = np.around(diffusion(675, -109.9, 0.001242), 3)\n",
    "porError_CONN = np.around(np.abs((maxdiff_CONN - maxdiff_CONN_T)/maxdiff_CONN_T) * 100, 3)\n",
    "\n",
    "print(f\"Max experimental diff for ICN: {maxdiff_ICN} px\")\n",
    "print(f\"Max theoretical diff for ICN:  {maxdiff_ICN_T} px\")\n",
    "print(f\"Porcentual error: {porError_ICN} %\\n\")\n",
    "\n",
    "\n",
    "print(f\"Max experimental diff for CONNIE: {maxdiff_CONN} px\")\n",
    "print(f\"Max theoretical diff for CONNIE:  {maxdiff_CONN_T} px\")\n",
    "print(f\"Porcentual error: {porError_CONN} %\")\n",
    "Colormap = 'jet'\n",
    "\n",
    "# print(time.time())\n",
    "# print(time.gmtime(0))"
   ]
